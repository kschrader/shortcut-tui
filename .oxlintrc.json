{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc", "import", "promise"],
  "jsPlugins": ["./lint/plugin.ts"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "shortcut-tui/no-comments": "error",
    "shortcut-tui/switch-on-discriminant": "error",
    "shortcut-tui/opentui-text-placement": "error",
    "shortcut-tui/paginate-v4-lists": "error",
    "shortcut-tui/keys-from-table": "error",
    "shortcut-tui/classify-every-raw-enum-value": "error",
    "shortcut-tui/bound-fan-out": "error",
    "shortcut-tui/parse-shortcut-responses": "error",
    "shortcut-tui/fields-from-schemas": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@shortcut/client", "@shortcut/client/*"],
            "message": "Only src/shortcut/client.ts talks to Shortcut, so every response is parsed in one place. Add a method to ShortcutClient there."
          }
        ]
      }
    ],

    "no-console": "error",
    "unicorn/no-process-exit": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/return-await": "error",
    "typescript/only-throw-error": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "consistent-return": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/consistent-type-imports": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/no-array-index-key": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-cycle": "error",
    "prefer-const": "error",
    "eqeqeq": "error",
    "no-param-reassign": "error",
    "no-nested-ternary": "error",
    "max-lines": [
      "error",
      {
        "max": 400,
        "skipBlankLines": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/shortcut/client.ts", "lint/fixtures/**"],
      "rules": { "no-restricted-imports": "off" }
    }
  ],
  "ignorePatterns": ["node_modules"]
}
