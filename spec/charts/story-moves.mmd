---
title: "Moving a story while a refresh can race it"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: saving
    lg1: failed
    lg2: settled
  }
  class lg0 blue
  class lg1 orange
  class lg2 teal
  s0: Shows Ready
  s1: Shows In Progress, saving In Progress
  s2: Move failed, shows Ready
  s3: Shows Ready, saving In Progress, Ready queued
  s4: Moved, shows In Progress
  s5: Shows Ready, saving Ready
  s6: Shows In Progress
  s7: Move failed, shows In Progress
  s8: Moved, shows Ready
  [*] --> s0
  s0 --> s1: you pick In Progress
  s1 --> s2: Shortcut refuses the move to In Progress
  s1 --> s3: you pick Ready [while a move saves]
  s2 --> s1: you pick In Progress
  s1 --> s4: Shortcut confirms the move to In Progress
  s3 --> s2: Shortcut refuses the move to In Progress
  s2 --> s0: the refresh returns
  s4 --> s5: you pick Ready
  s3 --> s5: Shortcut confirms the move to In Progress, the queued pick is sent
  s4 --> s6: the refresh returns
  s5 --> s7: Shortcut refuses the move to Ready
  s6 --> s5: you pick Ready
  s5 --> s8: Shortcut confirms the move to Ready
  s7 --> s6: the refresh returns
  s8 --> s0: the refresh returns
  class s0 teal
  class s1 blue
  class s2 orange
  class s3 blue
  class s4 teal
  class s5 blue
  class s6 teal
  class s7 orange
  class s8 teal
